# Bez klíče běží nástroj v režimu „pouze pravidla“ (deterministický výběr z knihovny).
# S klíčem Claude upřesní výběr, formulace a doplní otázky pro projektanta.
ANTHROPIC_API_KEY=
# Volitelné – výchozí je claude-opus-5
ANTHROPIC_MODEL=
# Volitelné: ochrana celé aplikace heslem (HTTP Basic). Uživatel výchozí „sagasta“.
SAGASTA_PASSWORD=
SAGASTA_USER=
# Volitelné: násobek limitů požadavků na IP (výchozí 1 = 30 běhů nástrojů / min)
SAGASTA_RATE_LIMIT=
